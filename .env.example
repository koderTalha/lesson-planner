# Local development only. Do not commit a real .env to git.
# Production / CI: use:
#   flutter build apk --release --dart-define=GEMINI_API_KEY=... --dart-define=GEMINI_MODEL=gemini-2.5-flash
# Store builds: users can enter the API key in the app (saved on device).
#
# Optional local file (not bundled): copy to .env and set:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
